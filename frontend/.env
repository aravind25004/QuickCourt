# QuickCourt Environment Configuration

# Set to your live backend REST API URL (e.g., http://localhost:5000/api or https://api.quickcourt.in/api)
VITE_API_URL=http://localhost:5000/api

# Set to 'true' to send live HTTP requests to VITE_API_URL, or 'false' to use the rich persistent client storage
VITE_USE_LIVE_BACKEND=false

# Application metadata
VITE_APP_NAME=QuickCourt
VITE_DEFAULT_CITY=ahmedabad
